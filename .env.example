# AWS region for the Bedrock runtime client.
AWS_REGION=us-east-1

# Bedrock model identifier used with the Converse API. Must support Converse
# tool use. Use a model/inference-profile ID your account has access to, e.g.
#   us.amazon.nova-lite-v1:0                        (default; no access request)
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0    (needs Anthropic use-case form)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Directory containing HR policy Markdown documents (relative to repo root or absolute).
POLICY_DIR=document-base

# Maximum LLM <-> tool iterations before the agent gives up.
AGENT_MAX_ITERATIONS=5

# LLM backend: "bedrock" (default) calls AWS Bedrock; "stub" returns canned
# answers with no AWS calls - useful for local API/UI testing.
LLM_BACKEND=bedrock

# AWS credentials are resolved through the standard AWS credential chain
# (environment, shared config/credentials file, SSO, instance role, ...).
# Never commit real credentials.
